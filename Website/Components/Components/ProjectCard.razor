@code {

    [Parameter]
    public Project Project { get; set; } = null!;

}

<article class="project-card">
    <header class="project-header">
        <a href="@Project.Url">@Project.Name</a>
    </header>

    <p class="project-description">@Project.Description</p>

    <div class="divider"></div>

    <ul class="tags" aria-label="Project technologies">
        @foreach (var tag in Project.Tags)
        {
            <li>@tag</li>
        }
    </ul>
</article>

<style>
    .project-card {
        width: 100%;
        box-sizing: border-box;
        padding: 28px 32px 24px;

        background: var(--background-1);
        border-radius: 24px;

        color: #c8d4ff;
    }

    .project-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 24px;
    }

    .project-icon {
        font-size: 34px;
        line-height: 1;
    }

    .project-header a {
        margin: 0;

        font-size: 24px;
        line-height: 1;
        font-weight: 700;
        letter-spacing: 0.04em;

        color: var(--text);
    }

    .project-header a:hover {
        color: var(--text-hover);
    }

    a, a:hover, a:visited, a:active {
        text-decoration: none;
    }

    .project-description {
        max-width: 560px;
        margin: 0 0 42px;

        font-size: 18px;
        line-height: 1.3;
        letter-spacing: 0.03em;

        color: var(--text-description);
    }

    .divider {
        height: 1px;
        margin-bottom: 16px;

        background: #1c2943;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;

        margin: 0;
        padding: 0;

        list-style: none;
    }

    .tags li {
        padding: 4px 16px 5px;
        cursor: pointer;

        background: var(--background-2);
        border-radius: 999px;

        font-size: 16px;
        line-height: 1;
        letter-spacing: 0.04em;

        color: var(--text);
        transition: background-color 0.30s cubic-bezier(0.33, 1, 0.68, 1);
    }

    .tags li:hover {
        background: var(--background-2-hovered);
        color: var(--text-hover);
        transition: background-color 0.30s cubic-bezier(0.33, 1, 0.68, 1);
    }
</style>
