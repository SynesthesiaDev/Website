<div style="@GetStyle()"></div>

@code {
    [Parameter]
    public string Size { get; set; } = "1rem";

    [Parameter]
    public string Direction { get; set; } = "vertical";

    private string GetStyle()
    {
        return Direction == "vertical" 
            ? $"height: {Size};" 
            : $"width: {Size};";
    }
}